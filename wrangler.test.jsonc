/**
 * Test configuration for Wrangler
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "onaria-platform-test",
	"main": "worker/index.ts",
	"compatibility_date": "2025-08-10",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "test_db",
			"database_id": "test-db-id"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
			{
				"class_name": "UserAppSandboxService",
				"name": "Sandbox"
			},
			{
				"class_name": "DORateLimitStore",
				"name": "DORateLimitStore"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "VibecoderStore",
			"id": "test-kv-id"
		}
	],
	"r2_buckets": [
		{
			"binding": "TEMPLATES_BUCKET",
			"bucket_name": "test-templates"
		}
	],
	"vars": {
		"TEMPLATES_REPOSITORY": "https://github.com/cloudflare/vibesdk-templates",
		"ALLOWED_EMAIL": "test@example.com",
		"DISPATCH_NAMESPACE": "",
		"ENABLE_READ_REPLICAS": "false",
		"CLOUDFLARE_AI_GATEWAY": "test-gateway",
		"CUSTOM_DOMAIN": "test.onaria.xyz",
		"CLOUDFLARE_ACCOUNT_ID": "test-account-id",
		"MAX_SANDBOX_INSTANCES": "1",
		"SANDBOX_INSTANCE_TYPE": "standard-1",
		"USE_CLOUDFLARE_IMAGES": "false",
		"GIT_AUTHOR_NAME": "Test User",
		"GIT_AUTHOR_EMAIL": "test@example.com"
	}
}
