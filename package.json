{
	"name": "onaria-platform",
	"private": true,
	"version": "2.2.9",
	"description": "AI-powered full-stack application generation platform with cosmic design system, built on Cloudflare infrastructure",
	"type": "module",
	"scripts": {
		"setup": "tsx scripts/setup.ts",
		"prepare": "husky",
		"dev": "DEV_MODE=true vite",
		"build": "tsc -b --incremental && vite build",
		"typecheck": "tsc -b --incremental --noEmit",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"deploy": "bun --env-file .prod.vars scripts/deploy.ts",
		"cf-typegen": "wrangler types --include-runtime false",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run -c vitest.integration.config.ts test/integration",
		"test:e2e": "vitest run -c vitest.integration.config.ts test/e2e",
		"test:lifecycle": "vitest run -c vitest.integration.config.ts test/e2e/complete-lifecycle.test.ts",
		"test:integration:verbose": "VERBOSE=true vitest run -c vitest.integration.config.ts test/integration",
		"test:e2e:verbose": "VERBOSE=true vitest run -c vitest.integration.config.ts test/e2e",
		"test:all": "npm run test && npm run test:integration && npm run test:e2e",
		"db:generate": "drizzle-kit generate --config=drizzle.config.local.ts",
		"db:generate:remote": "drizzle-kit generate --config=drizzle.config.remote.ts",
		"db:migrate:local": "wrangler d1 migrations apply onaria_db --local",
		"db:migrate:remote": "CI=true wrangler d1 migrations apply onaria_db --remote",
		"db:studio": "drizzle-kit studio --config=drizzle.config.local.ts",
		"db:studio:remote": "drizzle-kit studio --config=drizzle.config.remote.ts",
		"db:drop": "drizzle-kit drop --config=drizzle.config.local.ts",
		"db:drop:remote": "drizzle-kit drop --config=drizzle.config.remote.ts",
		"db:introspect": "drizzle-kit introspect --config=drizzle.config.local.ts",
		"db:check": "drizzle-kit check --config=drizzle.config.local.ts",
		"db:up": "drizzle-kit up --config=drizzle.config.local.ts",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"knip:production": "knip --production",
		"knip:dependencies": "knip --dependencies",
		"knip:exports": "knip --exports",
		"capture-screenshots": "tsx scripts/capture-screenshots-simple.ts"
	},
	"dependencies": {
		"@ashishkumar472/cf-git": "1.0.5",
		"@cloudflare/containers": "^0.0.28",
		"@cloudflare/sandbox": "0.4.14",
		"@noble/ciphers": "^1.3.0",
		"@octokit/rest": "^22.0.1",
		"@radix-ui/react-alert-dialog": "^1.1.6",
		"@radix-ui/react-avatar": "^1.1.3",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-popover": "^1.1.6",
		"@radix-ui/react-scroll-area": "^1.2.3",
		"@radix-ui/react-select": "^2.1.6",
		"@radix-ui/react-separator": "^1.1.2",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-switch": "^1.1.3",
		"@radix-ui/react-tabs": "^1.1.3",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@sentry/cloudflare": "^10.22.0",
		"@sentry/react": "^10.22.0",
		"@vitejs/plugin-react": "^5.1.0",
		"agents": "^0.2.20",
		"class-variance-authority": "^0.7.1",
		"cloudflare": "^4.5.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"diff": "^8.0.2",
		"drizzle-orm": "^0.44.7",
		"esbuild": "^0.25.12",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"fflate": "^0.8.2",
		"framer-motion": "^12.23.24",
		"hono": "^4.10.4",
		"html2canvas-pro": "^1.5.12",
		"jose": "^5.10.0",
		"jsonc-parser": "^3.3.1",
		"lucide-react": "^0.487.0",
		"monaco-editor": "^0.52.2",
		"nanoid": "^5.1.6",
		"next-themes": "^0.4.6",
		"openai": "^5.23.2",
		"partysocket": "^1.1.6",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-feather": "^2.0.10",
		"react-hot-toast": "^2.6.0",
		"react-markdown": "^10.1.0",
		"react-router": "^7.9.5",
		"rehype-external-links": "^3.0.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"vite-plugin-svgr": "^4.5.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.18",
		"@cloudflare/vitest-pool-workers": "^0.8.71",
		"@cloudflare/workers-types": "^4.20251014.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@eslint/js": "^9.39.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.16",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.18.13",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitest/coverage-v8": "^3.2.4",
		"drizzle-kit": "^0.31.6",
		"eslint": "^9.39.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"happy-dom": "^20.0.10",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"knip": "^5.66.4",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tsx": "^4.20.6",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vite": "npm:rolldown-vite@7.1.13",
		"vitest": "^3.2.4",
		"wrangler": "4.45.0"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true
	},
	"overrides": {
		"@cloudflare/containers": "^0.0.28",
		"esbuild": "^0.25.12"
	}
}
